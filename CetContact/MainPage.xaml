<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CetContact.MainPage"
             xmlns:models="clr-namespace:CetContact.Models"
             xmlns:vm="clr-namespace:CetContact.ViewModels"
             x:DataType="vm:ContactViewModel">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="16">

        <!-- Form -->
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Entry Placeholder="Name" Text="{Binding Name}" />
            <Entry Placeholder="Phone" Keyboard="Telephone" Text="{Binding Phone}" />
            <Entry Placeholder="Email" Keyboard="Email" Text="{Binding Email}" />

            <HorizontalStackLayout Spacing="8">
                <Button Text="{Binding SaveButtonText}" Command="{Binding SaveCommand}" />
                <Button Text="Delete" Command="{Binding DeleteCommand}" BackgroundColor="IndianRed" />
                <Button Text="Clear" Command="{Binding ClearCommand}" BackgroundColor="Gray" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- List -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Contacts}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedContact}">
            <CollectionView.EmptyView>
                <Label Text="No contacts yet." HorizontalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PhoneContact">
                    <VerticalStackLayout Padding="8">
                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                        <Label Text="{Binding PhoneNumber}" />
                        <Label Text="{Binding Email}" TextColor="Gray" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
